# GEMINI_API_KEY: Optional API key for Gemini AI calls.
# If empty, the app runs in zero-latency deterministic offline mode.
GEMINI_API_KEY=""

# OPENROUTER_API_KEY: Optional API key for OpenRouter AI provider.
# If configured, enables OpenRouter models (Llama 3.3, Mistral, DeepSeek, etc.) for NLP workload parsing & insights.
OPENROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
